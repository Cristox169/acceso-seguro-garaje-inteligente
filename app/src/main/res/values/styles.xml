<resources>
    <style name="Theme.GarajeInteligente" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#0E1929</item>
        <item name="android:navigationBarColor">#0B1220</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.GarajeInteligente.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E1929</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GarajeInteligente</item>
    </style>
</resources>
